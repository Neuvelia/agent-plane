      }
     }
    ],
    "requires": [
     {
      "key": "kind",
      "equals": "reported_file_scope"
     }
    ]
   }
  ],
  "outputs": [
   {
    "name": "verdict",
    "type": "string"
   }
  ],
  "outputs_locked": false
 },
 "human": {
  "config": [
   {
    "id": "human.config.prompt",
    "key": "prompt",
    "kind": "text",
    "max_bytes": 1024
   },
   {
    "id": "human.config.context_inputs",
    "key": "context_inputs",
    "kind": "list",
    "max_items": 8,
    "item": {
     "id": "human.config.context_inputs.item",
     "kind": "input_name",
     "input_types": [
      "string"
     ]
    }
   }
  ],
  "outputs": [
   {
    "name": "decision",
    "type": "string",
    "required": true
   }
  ],
  "outputs_locked": true
 },
