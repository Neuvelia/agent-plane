      "command": "/usr/bin/printf"
     },
     "outputs": {
      "stdout": {
       "type": "string",
       "required": true
      }
     }
    },
    "flaky": {
     "type": "shell",
     "loop": {
      "max_attempts": 3,
      "gate": {
       "inputs": {
        "candidate": {
         "type": "json",
         "required": true
        }
       },
       "config": {
        "check_id": "flaky-ready",
        "expected": true,
        "field": [
         "ready"
        ],
        "input": "candidate",
        "kind": "json_predicate",
        "operator": "eq"
       }
      },
      "bindings": [
       {
        "from": "candidate.outputs.json",
        "to": "gate.inputs.candidate"
       }
      ]
     },
     "config": {
      "args": [
       "-c",
       "if [ \"$AGENTPLANE_ATTEMPT\" = 1 ]; then echo \"{\\\"ready\\\":false}\"; else echo \"{\\\"ready\\\":true}\"; fi"
      ],
      "command": "/bin/sh",
      "stdout_json": true
     },
     "outputs": {
      "json": {
       "type": "json",
       "required": true
      }
     }
    }
   },
   "edges": [
