{
 "agent": {
  "config": [
   {
    "id": "agent.config.adapter",
    "key": "adapter",
    "kind": "string",
    "required": true,
    "format": "not_blank"
   },
   {
    "id": "agent.config.workspace",
    "key": "workspace",
    "kind": "string",
    "required": true,
    "format": "absolute_path"
   },
   {
    "id": "agent.config.task",
    "key": "task",
    "kind": "text",
    "required": true,
    "format": "not_blank",
    "excludes": [
     {
      "input": "task"
     }
    ]
   },
   {
    "id": "agent.config.allowed_paths",
    "key": "allowed_paths",
    "kind": "path_list",
    "item": {
     "id": "agent.config.allowed_paths.item",
     "kind": "string",
     "format": "not_blank"
    }
   },
   {
    "id": "agent.config.context_refs",
    "key": "context_refs",
    "kind": "list",
    "item": {
     "id": "agent.config.context_refs.item",
     "kind": "string",
     "format": "not_blank"
    }
   },
   {
    "id": "agent.config.environment_refs",
    "key": "environment_refs",
    "kind": "list",
    "item": {
     "id": "agent.config.environment_refs.item",
     "kind": "string",
     "format": "not_blank"
    }
   },
   {
    "id": "agent.config.isolation",
    "key": "isolation",
    "kind": "enum",
    "default": "none",
    "enum": [
     "none",
     "worktree"
    ]
   }
  ],
  "outputs": [
   {
    "name": "summary",
    "type": "string"
   },
   {
    "name": "changed_files",
    "type": "json"
   },
   {
    "name": "artifacts",
    "type": "json"
   },
   {
    "name": "raw_metadata",
    "type": "json"
   },
   {
    "name": "usage",
    "type": "json"
   }
  ],
  "outputs_locked": false,
  "loop": {
   "fields": [
    {
     "id": "loop.max_attempts",
     "key": "max_attempts",
     "kind": "int",
     "default": 3,
     "min": 1,
     "max": 10
    }
   ],
   "gate": [
    {
     "id": "gate.config.check_id",
     "key": "check_id",
     "kind": "string",
     "required": true,
     "max_bytes": 256,
     "format": "not_blank"
    },
    {
     "id": "gate.config.kind",
     "key": "kind",
     "kind": "enum",
     "required": true,
     "enum": [
      "command",
      "json_predicate",
      "reported_file_scope",
      "changed_files_scope"
     ]
    },
    {
     "id": "gate.config.command",
     "kind": "group",
     "fields": [
      {
       "id": "gate.config.command.command",
       "key": "command",
       "kind": "string",
       "required": true,
       "locked": {
        "value": "/usr/bin/diff",
        "reason": "a command Gate compares two inputs with /usr/bin/diff only"
       }
      },
      {
       "id": "gate.config.command.cwd",
       "key": "cwd",
       "kind": "string",
       "required": true,
       "format": "clean_absolute_path"
      },
      {
       "id": "gate.config.command.left_input",
       "key": "left_input",
       "kind": "input_name",
       "required": true,
       "input_types": [
        "string"
       ],
       "input_required": true
      },
      {
       "id": "gate.config.command.right_input",
       "key": "right_input",
       "kind": "input_name",
       "required": true,
       "input_types": [
        "string"
       ],
       "input_required": true
      }
     ],
     "requires": [
      {
       "key": "kind",
       "equals": "command"
      }
     ]
    },
    {
     "id": "gate.config.json_predicate",
     "kind": "group",
     "fields": [
      {
       "id": "gate.config.json_predicate.input",
       "key": "input",
       "kind": "input_name",
       "required": true,
       "input_types": [
        "json"
       ],
       "input_required": true
      },
      {
       "id": "gate.config.json_predicate.field",
       "key": "field",
       "kind": "list",
       "required": true,
       "item": {
        "id": "gate.config.json_predicate.field.item",
        "kind": "string",
        "format": "nonempty"
       }
      },
      {
       "id": "gate.config.json_predicate.operator",
       "key": "operator",
       "kind": "enum",
       "required": true,
       "enum": [
        "eq",
        "ne"
       ]
      },
      {
       "id": "gate.config.json_predicate.expected",
       "key": "expected",
       "kind": "scalar",
       "required": true,
       "excludes": [
        {
         "key": "expected_json"
        }
       ]
      },
      {
       "id": "gate.config.json_predicate.expected_json",
       "key": "expected_json",
       "kind": "string",
       "required": true,
       "format": "json_scalar",
       "excludes": [
        {
         "key": "expected"
        }
       ]
      }
     ],
     "requires": [
      {
       "key": "kind",
       "equals": "json_predicate"
      }
     ]
    },
    {
     "id": "gate.config.reported_file_scope",
     "kind": "group",
     "fields": [
      {
       "id": "gate.config.reported_file_scope.input",
       "key": "input",
       "kind": "input_name",
       "required": true,
       "input_types": [
        "json"
       ],
       "input_required": true
      },
      {
       "id": "gate.config.reported_file_scope.allowed_paths",
       "key": "allowed_paths",
       "kind": "path_list",
       "required": true,
       "item": {
        "id": "gate.config.reported_file_scope.allowed_paths.item",
        "kind": "string",
        "format": "relative_path"
       }
      }
     ],
     "requires": [
      {
       "key": "kind",
       "equals": "reported_file_scope"
      }
     ]
    },
    {
     "id": "gate.config.changed_files_scope",
     "kind": "group",
     "fields": [
      {
       "id": "gate.config.changed_files_scope.input",
       "key": "input",
       "kind": "input_name",
       "required": true,
       "input_types": [
        "string",
        "json"
       ],
       "input_required": true
      },
      {
       "id": "gate.config.changed_files_scope.allowed_paths",
       "key": "allowed_paths",
       "kind": "path_list",
       "required": true,
       "item": {
        "id": "gate.config.changed_files_scope.allowed_paths.item",
        "kind": "string",
        "format": "relative_path"
       }
      },
      {
       "id": "gate.config.changed_files_scope.mode",
       "key": "mode",
       "kind": "enum",
       "required": true,
       "default": "warn",
       "enum": [
        "warn",
        "deny"
       ]
      },
      {
       "id": "gate.config.changed_files_scope.workspace",
       "key": "workspace",
       "kind": "string",
       "required": true,
       "format": "clean_absolute_path"
      }
     ],
     "requires": [
      {
       "key": "kind",
       "equals": "changed_files_scope"
      }
     ]
    }
   ],
   "gate_kinds": [
    "command",
    "json_predicate",
    "reported_file_scope",
    "changed_files_scope"
   ]
  }
 },
