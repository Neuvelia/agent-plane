{
  "name": "agentplane-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "AgentPlane desktop shell: Electron main + React renderer over the local agentplane sidecar",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node scripts/sync-tokens.mjs --check && npm run typecheck && npm test && npm run build && npm run build-storybook && node scripts/check-bundle.mjs",
    "tokens": "node scripts/sync-tokens.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry -o storybook-static",
    "stories:test": "node scripts/stories-smoke.cjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "electron": "^45.3.2",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
